ipopt_output.txt
# IKFlow weights are large binaries obtained/trained separately, never tracked. The
# trained Panda charts (n4/n6/n8/n12/n12_w256) normally live only on the cluster, so
# nothing covered them until one was pulled down to reproduce a bug locally -- at
# which point a `git add -A` would have committed 97 MB. The .arch.json sidecars ARE
# tracked: they are ~700 bytes and a checkpoint without its sidecar loads silently
# against the wrong architecture.
models/iiwa14/*.pkl
models/panda/panda__*.pkl
## The soft arm's rungs: checkpoints, and any learned forward-model weights. Same rule as
## the rigid arms' -- weights are regenerable and do not belong in git.
models/soft9/*.pkl
models/soft12/*.pkl
models/soft16/*.pkl
models/soft*/*__fk_surrogate.pt
models/soft*/*__fk_surrogate.json
notebooks/artifacts
results/

workshop-paper-draft.pdf

__pycache__/
*.pyc
ikflow_solver_log.txt

# cluster audit log and job logs
logs/

# wandb CLI scratch (offline runs live under results/)
wandb/

