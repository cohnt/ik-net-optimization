    <!-- The tip is one sub-arc past the last sub-link's origin, so it is nobody's
         frame and needs a body of its own: the frame the gripper welds to and the
         frame the flow is conditioned on. Its sphere closes the union over the
         final sub-arc of rod. It joins the LAST segment's filter group, so it
         neither collides with the segment it caps nor with the one before it. -->
    <link name="gvs_tip_link">
      <inertial><mass>0.027027027</mass><inertia><ixx>4.76756757e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>4.76756757e-06</iyy><iyz>0</iyz><izz>4.76756757e-06</izz></inertia></inertial>
      <collision name="gvs_tip_link_collision"><geometry>
        <sphere><radius>0.021</radius></sphere>
      </geometry></collision>
      <visual name="gvs_tip_link_visual"><geometry>
        <sphere><radius>0.021</radius></sphere>
      </geometry></visual>
    </link>
    <!-- SoRoMoX's backbone is its local x-axis, so the tip BODY's x points along
         the rod; the tip FRAME is pitched by +90 degrees so that its z does, which
         is the convention the gripper weld and the flow's conditioning pose use
         on every other robot here. -->
    <frame name="gvs_tip" attached_to="gvs_tip_link">
      <pose relative_to="gvs_tip_link">0 0 0 0 1.5707963267948966 0</pose>
    </frame>

    <!-- Self-collision is filtered WITHIN a segment and between ADJACENT segments:
         consecutive spheres overlap by construction, which is what makes the union
         a rod rather than a string of beads. Non-adjacent segments stay live, and
         they bind: this arm can curl through itself. -->
    <drake:collision_filter_group name="seg0"><drake:member>seg0_sub0</drake:member><drake:member>seg0_sub1</drake:member><drake:member>seg0_sub2</drake:member><drake:member>seg0_sub3</drake:member><drake:member>seg0_sub4</drake:member><drake:member>seg0_sub5</drake:member><drake:member>seg0_sub6</drake:member><drake:member>seg0_sub7</drake:member><drake:member>seg0_sub8</drake:member><drake:member>seg0_sub9</drake:member><drake:member>seg0_sub10</drake:member><drake:member>seg0_sub11</drake:member><drake:ignored_collision_filter_group>seg0</drake:ignored_collision_filter_group><drake:ignored_collision_filter_group>seg1</drake:ignored_collision_filter_group></drake:collision_filter_group>
    <drake:collision_filter_group name="seg1"><drake:member>seg1_sub0</drake:member><drake:member>seg1_sub1</drake:member><drake:member>seg1_sub2</drake:member><drake:member>seg1_sub3</drake:member><drake:member>seg1_sub4</drake:member><drake:member>seg1_sub5</drake:member><drake:member>seg1_sub6</drake:member><drake:member>seg1_sub7</drake:member><drake:member>seg1_sub8</drake:member><drake:member>seg1_sub9</drake:member><drake:member>seg1_sub10</drake:member><drake:member>seg1_sub11</drake:member><drake:ignored_collision_filter_group>seg1</drake:ignored_collision_filter_group><drake:ignored_collision_filter_group>seg2</drake:ignored_collision_filter_group></drake:collision_filter_group>
    <drake:collision_filter_group name="seg2"><drake:member>seg2_sub0</drake:member><drake:member>seg2_sub1</drake:member><drake:member>seg2_sub2</drake:member><drake:member>seg2_sub3</drake:member><drake:member>seg2_sub4</drake:member><drake:member>seg2_sub5</drake:member><drake:member>seg2_sub6</drake:member><drake:member>seg2_sub7</drake:member><drake:member>seg2_sub8</drake:member><drake:member>seg2_sub9</drake:member><drake:member>seg2_sub10</drake:member><drake:member>seg2_sub11</drake:member><drake:member>gvs_tip_link</drake:member><drake:ignored_collision_filter_group>seg2</drake:ignored_collision_filter_group></drake:collision_filter_group>
  </model>
</sdf>
