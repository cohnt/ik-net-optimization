    <!-- The tip is one sub-arc past the last sub-link's origin, so it is nobody's
         frame and needs a body of its own: the frame the gripper welds to and the
         frame the flow is conditioned on. It carries a collision sphere as well,
         because without one the final sub-arc of rod -- a whole sub-link length,
         33 mm -- is left outside the sphere union. The containment test measured
         exactly that before this sphere existed.
         It joins the LAST segment's filter group, so it neither collides with the
         segment it caps nor with the one before it. -->
    <link name="soft_tip_link">
      <inertial><mass>0.0322580645</mass><inertia><ixx>1.58064516e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.58064516e-05</iyy><iyz>0</iyz><izz>1.58064516e-05</izz></inertia></inertial>
      <collision name="soft_tip_link_collision"><geometry>
        <sphere><radius>0.035</radius></sphere>
      </geometry></collision>
      <visual name="soft_tip_link_visual"><geometry>
        <sphere><radius>0.035</radius></sphere>
      </geometry></visual>
    </link>
    <frame name="soft_tip" attached_to="soft_tip_link"/>

    <!-- Self-collision is filtered WITHIN a segment and between ADJACENT segments:
         consecutive spheres overlap by construction, which is what makes the union
         a rod rather than a string of beads. Non-adjacent segments stay live, and
         they bind: this arm can curl through itself. -->
    <drake:collision_filter_group name="seg0"><drake:member>seg0_sub0</drake:member><drake:member>seg0_sub1</drake:member><drake:member>seg0_sub2</drake:member><drake:member>seg0_sub3</drake:member><drake:member>seg0_sub4</drake:member><drake:member>seg0_sub5</drake:member><drake:member>seg0_sub6</drake:member><drake:member>seg0_sub7</drake:member><drake:member>seg0_sub8</drake:member><drake:member>seg0_sub9</drake:member><drake:ignored_collision_filter_group>seg0</drake:ignored_collision_filter_group><drake:ignored_collision_filter_group>seg1</drake:ignored_collision_filter_group></drake:collision_filter_group>
    <drake:collision_filter_group name="seg1"><drake:member>seg1_sub0</drake:member><drake:member>seg1_sub1</drake:member><drake:member>seg1_sub2</drake:member><drake:member>seg1_sub3</drake:member><drake:member>seg1_sub4</drake:member><drake:member>seg1_sub5</drake:member><drake:member>seg1_sub6</drake:member><drake:member>seg1_sub7</drake:member><drake:member>seg1_sub8</drake:member><drake:member>seg1_sub9</drake:member><drake:ignored_collision_filter_group>seg1</drake:ignored_collision_filter_group><drake:ignored_collision_filter_group>seg2</drake:ignored_collision_filter_group></drake:collision_filter_group>
    <drake:collision_filter_group name="seg2"><drake:member>seg2_sub0</drake:member><drake:member>seg2_sub1</drake:member><drake:member>seg2_sub2</drake:member><drake:member>seg2_sub3</drake:member><drake:member>seg2_sub4</drake:member><drake:member>seg2_sub5</drake:member><drake:member>seg2_sub6</drake:member><drake:member>seg2_sub7</drake:member><drake:member>seg2_sub8</drake:member><drake:member>seg2_sub9</drake:member><drake:member>soft_tip_link</drake:member><drake:ignored_collision_filter_group>seg2</drake:ignored_collision_filter_group></drake:collision_filter_group>
